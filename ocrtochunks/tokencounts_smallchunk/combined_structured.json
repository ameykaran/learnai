  },
  {
    "text": "Y\nP(Y)\n-1\n$\\frac{1}{8}$\n0\n$\\frac{2}{8}$\n4\n$\\frac{3}{8}$\n5\n$\\frac{1}{8}$\n6\n$\\frac{1}{8}$",
    "page_number": 4,
